{
  "name": "@deepseek-ai/dsh-tteoki",
  "description": "Tteoki's command-line companion: dsh tteoki agenda, sync, kb, and runs over the knowledge-base, connectors, and worktrees services",
  "version": "0.1.7-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/tteoki"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-cmdline": "workspace:*",
    "@deepseek-ai/dsh-connectors": "workspace:*",
    "@deepseek-ai/dsh-memory": "workspace:*",
    "@deepseek-ai/dsh-memory-notability": "workspace:*",
    "@deepseek-ai/dsh-memory-pdf": "workspace:*",
    "@deepseek-ai/dsh-worktrees": "workspace:*",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  }
}
